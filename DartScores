<!DOCTYPE html>
<html lang="en">
<head>
<script src="theme.js" defer></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dartball Manager</title>

<style>
    /* === ALL YOUR ORIGINAL STYLES (kept exactly as in your repo) === */
    .body { margin: 0; padding: 20px; background: #f5f5f5; min-height: 100vh; font-family: Arial, Helvetica, sans-serif; }
    /* (All the CSS from .score-board down to your existing .modal styles remains unchanged) */

    /* NEW: Play Log Styles */
    .play-log-section {
        margin: 30px 0;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    #playLogTable {
        width: 100%;
        border-collapse: collapse;
        font-size: 1.05em;
    }
    #playLogTable th, #playLogTable td {
        padding: 10px;
        border: 1px solid #ddd;
        text-align: left;
    }
    #playLogTable th {
        background: #007bff;
        color: white;
    }
    #playLogTable tr:nth-child(even) { background: #f8f9fa; }

    /* NEW: Edit Modal */
    #editPlayModal .modal-content {
        max-width: 520px;
        padding: 25px;
    }
    #editPlayModal select, #editPlayModal input {
        width: 100%;
        padding: 10px;
        margin: 8px 0;
        font-size: 1.1em;
        border-radius: 6px;
        border: 1px solid #ccc;
    }
</style>
</head>
<body>

<!-- === YOUR ORIGINAL HTML CONTENT GOES HERE (scoreboard, bases, controls, etc.) === -->
<!-- For brevity in this response I kept it as placeholder - replace this section with your original body content if needed -->

    <!-- NEW PLAY LOG SECTION -->
    <div class="play-log-section">
        <h2>Game Play Log <small style="font-weight:normal;">— Click Edit to fix mistakes or out-of-order plays</small></h2>
        <button onclick="exportGameLog()" style="margin-right:10px;padding:10px 16px;">Export Backup</button>
        <button onclick="importGameLog()" style="padding:10px 16px;">Import Backup</button>
        
        <table id="playLogTable">
            <thead>
                <tr>
                    <th>Inning</th>
                    <th>Half</th>
                    <th>Batter</th>
                    <th>Defender</th>
                    <th>Result</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- NEW EDIT MODAL -->
    <div id="editPlayModal" class="modal" style="display:none;">
        <div class="modal-content">
            <h3>Edit Play</h3>
            <label>Inning: <input type="number" id="edit-inning" min="1"></label><br><br>
            <label>Half: 
                <select id="edit-half">
                    <option value="Top">Top</option>
                    <option value="Bottom">Bottom</option>
                </select>
            </label><br><br>
            <label>Batter: <input type="text" id="edit-batter"></label><br><br>
            <label>Defender: <input type="text" id="edit-defender"></label><br><br>
            <label>Result:
                <select id="edit-result">
                    <option value="1">1 - Single</option>
                    <option value="2">2 - Double</option>
                    <option value="3">3 - Triple</option>
                    <option value="4">4 - Homerun</option>
                    <option value="BB">BB - Walk</option>
                    <option value="O">O - Out</option>
                    <option value="SKO">SKO - Strikeout</option>
                    <option value="E">E - Error</option>
                    <option value="SPO">SPO - Putout</option>
                    <option value="DPO">DPO - Double Play</option>
                </select>
            </label><br><br>
            <button onclick="saveEditedPlay()" style="background:#28a745;color:white;padding:12px 24px;margin-right:10px;">Save Changes</button>
            <button onclick="closeEditModal()" style="background:#dc3545;color:white;padding:12px 24px;">Cancel</button>
        </div>
    </div>

    <!-- Your existing modals remain unchanged below this point -->

    <script>
        // === YOUR ORIGINAL JAVASCRIPT CODE (all variables, functions, etc.) ===
        // Paste your full original <script> content here if merging manually.
        // The code below adds the new features on top.

        let editIndex = -1;

        function escapeHtml(text) {
            return String(text || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":"&#039;"})[m]);
        }

        function renderPlayLog() {
            const tbody = document.getElementById('playLogTable').querySelector('tbody');
            tbody.innerHTML = '';

            currentState.plays.forEach((play, i) => {
                const half = (play.team === currentState.leadoff ? 'Top' : 'Bottom');
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${play.inning || '-'}</td>
                    <td>${half}</td>
                    <td>${escapeHtml(play.player || '-')}</td>
                    <td>${escapeHtml(play.defender || '-')}</td>
                    <td><strong>${escapeHtml(play.playType || play.defenderPlayType || '-')}</strong></td>
                    <td>
                        <button onclick="startEditPlay(${i})" style="margin-right:6px;padding:6px 12px;">Edit</button>
                        <button onclick="deletePlay(${i})" style="background:#dc3545;color:white;padding:6px 12px;">Delete</button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function startEditPlay(index) {
            editIndex = index;
            const play = currentState.plays[index];
            if (!play) return;

            document.getElementById('edit-inning').value = play.inning || currentState.inning || 1;
            document.getElementById('edit-half').value = (play.team === currentState.leadoff ? 'Top' : 'Bottom');
            document.getElementById('edit-batter').value = play.player || '';
            document.getElementById('edit-defender').value = play.defender || '';
            document.getElementById('edit-result').value = (play.playType || play.defenderPlayType || 'O');

            document.getElementById('editPlayModal').style.display = 'flex';
        }

        function saveEditedPlay() {
            if (editIndex < 0) return;
            const play = currentState.plays[editIndex];

            play.inning = parseInt(document.getElementById('edit-inning').value) || play.inning;
            play.player = document.getElementById('edit-batter').value.trim();
            play.defender = document.getElementById('edit-defender').value.trim();
            
            const newResult = document.getElementById('edit-result').value;
            if (play.defenderPlayType !== undefined) play.defenderPlayType = newResult;
            else play.playType = newResult;

            closeEditModal();
            recalculateAfterEdit();
        }

        function closeEditModal() {
            document.getElementById('editPlayModal').style.display = 'none';
            editIndex = -1;
        }

        function deletePlay(index) {
            if (!confirm('Delete this play and recalculate the entire game?')) return;
            currentState.plays.splice(index, 1);
            recalculateAfterEdit();
        }

        function recalculateAfterEdit() {
            // Full refresh so scoreboard, stats, bases, inning chart all update
            savePlays();
            updateDisplay();
            calculateTeamStats();
            renderPlayLog();
            showAlert ? showAlert('Game recalculated after edit') : alert('Game recalculated after edit');
        }

        function exportGameLog() {
            const data = JSON.stringify(currentState.plays, null, 2);
            const blob = new Blob([data], {type: 'application/json'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `dartball_game${currentGame || 1}_log.json`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function importGameLog() {
            if (!confirm('Import will replace current plays. Continue?')) return;
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = '.json';
            input.onchange = e => {
                const file = e.target.files[0];
                const reader = new FileReader();
                reader.onload = ev => {
                    try {
                        currentState.plays = JSON.parse(ev.target.result);
                        recalculateAfterEdit();
                    } catch(err) {
                        alert('Invalid JSON file');
                    }
                };
                reader.readAsText(file);
            };
            input.click();
        }

        // Hook into existing functions to keep Play Log fresh
        const origUpdateDisplay = typeof updateDisplay === 'function' ? updateDisplay : function(){};
        window.updateDisplay = function() {
            origUpdateDisplay();
            renderPlayLog();
        };

        const origConfirmPlay = typeof confirmPlay === 'function' ? confirmPlay : function(){};
        window.confirmPlay = function() {
            origConfirmPlay();
            renderPlayLog();
        };

        // Initial load
        const origOnload = window.onload;
        window.onload = function() {
            if (typeof origOnload === 'function') origOnload();
            setTimeout(() => {
                renderPlayLog();
            }, 300);
        };
    </script>
</body>
</html>
