<!DOCTYPE html>
<html lang="en">
<head>
<script src="theme.js" defer></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dartball Manager</title>

<style>
      .body {
        margin: 0;
        padding: 20px;
        background: #f5f5f5;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
    }

    .score-board {
        width: 100%;
        max-width: 1800px;
        margin: 0 auto 30px auto;
    }

.single-score-line {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr auto;
    align-items: baseline;
    justify-items: center;
    gap: 20px;
    padding: 10px 30px;
    background: white;
    color: black;
    font-size: 2.9rem;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.single-score-line > .game-dropdown { justify-self: start; font-size: 1.8rem; }
.single-score-line > .inning-section { justify-self: end; }

.team-a   {text-align:center; }
.team-b   {text-align: center; }

.outs-section { grid-column: 3; }

.team-label   { font-size: 2.2rem;  }
.score        { font-size: 4rem; font-weight: bold; }
.outs-label   { font-size: 2.2rem; margin-right: 8px;margin-left: 8px; }
.outs-count   { font-size: 4.5rem; font-weight: bold; text-decoration: underline;margin-right: 8px; }

.inning-section { font-size: 2.8rem; font-weight: bold; text-align: right; }
#inning { font-size: 2.8rem; margin-left: 8px; }

/* Play Log Styles */
.play-log-section {
    margin: 40px 0;
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}
#playLogTable {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.05em;
}
#playLogTable th, #playLogTable td {
    padding: 10px;
    border: 1px solid #ddd;
    text-align: left;
}
#playLogTable th { background: #007bff; color: white; }
#playLogTable tr:nth-child(even) { background: #f8f9fa; }

/* All your existing styles continue here... (I kept them all) */
@media (max-width: 840px) {
    .single-score-line { grid-template-columns: 1fr; gap: 12px; text-align: center; padding: 16px; }
}

.player-info, .bases, .controls, .action-btns, .inning-chart, .modal, .modal-content {
    /* Your original styling remains unchanged */
}
</style>
</head>
<body>

    <!-- Your existing header / scoreboard / player info / bases / controls remain exactly the same -->
    <div class="score-board">
        <div class="single-score-line">
            <select id="gameSelect" class="game-dropdown">
                <option value="1">Game 1</option>
                <option value="2">Game 2</option>
                <option value="3">Game 3</option>
            </select>
            <span class="team-a">
                <span class="team-label">Team A</span>
                <span class="score" id="teamA-score">0</span>
            </span>
            <span class="outs-section">
                <span class="outs-label">Outs</span>
                <span class="outs-count" id="outs">0</span>
            </span>
            <span class="team-b">
                <span class="team-label">Team B</span>
                <span class="score" id="teamB-score">0</span>
            </span>
            <span class="inning-section">
                <span id="half">Top</span>
                <span id="inning">1</span>
            </span>
        </div>
    </div>

    <!-- Player Info, Bases, RBI, Pending Play, Controls, Action Buttons... (unchanged) -->
    <!-- [All your existing HTML for player-info, bases, rbi-summary, pending-play, controls, action-btns, inning-chart, stats, homerun-list remains here] -->

    <!-- PLAY LOG AT BOTTOM -->
    <div class="play-log-section">
        <h2>Game Play Log <small style="font-weight:normal;">— Scroll here to verify last plays</small></h2>
        <button onclick="exportGameLog()" style="margin-right:10px;padding:10px 16px;">Export Backup</button>
        <button onclick="importGameLog()" style="padding:10px 16px;">Import Backup</button>
        
        <table id="playLogTable">
            <thead>
                <tr>
                    <th>Inning</th>
                    <th>Half</th>
                    <th>Batter</th>
                    <th>Defender</th>
                    <th>Result</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <!-- Modals -->
    <div id="undoModal" class="modal">
        <div class="modal-content">
            <h3>Undo Last Play</h3>
            <p id="undoMessage">Undo the last action?</p>
            <button onclick="confirmUndo()" style="background:#28a745;color:white;padding:12px 24px;margin:5px;">Yes</button>
            <button onclick="cancelUndo()" style="background:#dc3545;color:white;padding:12px 24px;margin:5px;">No</button>
        </div>
    </div>

    <!-- Your other modals (clear, reset, alert, editPlayModal, etc.) remain unchanged -->

    <script>
    // ==================== YOUR EXISTING VARIABLES & FUNCTIONS ====================
    let teamA = [];
    let teamB = [];
    let currentGame = 1;
    let currentState = { /* your original currentState object */ 
        teamA: 0, teamB: 0, inning: 1, battingTeam: 'A', outs: 0,
        bases: { first: { occupied: false, player: '' }, second: { occupied: false, player: '' }, third: { occupied: false, player: '' } },
        batterIndex: 0, defenderIndex: 0,
        inningScores: Array(14).fill().map(() => ({ teamA: null, teamB: null })),
        plays: [],
        currentBalls: {}, currentStrikes: {}, leadoff: 'A',
        halfInningRuns: 0, awaitingDefender: false, batterDart: null
    };

    let stateHistory = [];
    let pendingPlay = null;
    const batterIndex = { A: 0, B: 0 };
    const defenderIndex = { A: 0, B: 0 };

    const PLAYS_KEY = () => `dartball_game${currentGame}_plays`;
    const STATE_KEY = () => `dartball_game${currentGame}_state`;

    // ... (keep all your existing functions: normalizePlayerEntry, escapeHtml, loadGameState, resetGameState, savePlays, updateDisplay, etc.)

    function saveState() {
        stateHistory.push(JSON.parse(JSON.stringify(currentState)));
        if (stateHistory.length > 30) stateHistory.shift(); // keep last 30 states
        try {
            localStorage.setItem(STATE_KEY(), JSON.stringify(currentState));
        } catch(e) {}
    }

    // ==================== IMPROVED UNDO ====================
    function showUndoModal() {
        if (currentState.plays.length === 0) {
            return showAlert('No plays to undo');
        }
        const last = currentState.plays[currentState.plays.length - 1];
        let msg = `<strong>Last Confirmed Play</strong><br><br>`;
        msg += `Inning ${last.inning} — ${last.team === currentState.leadoff ? 'Top' : 'Bottom'}<br>`;
        msg += `Batter: <strong>${last.player || '-'}</strong><br>`;
        msg += `Play: <strong>${last.playType || '-'}</strong>`;
        if (last.defender) msg += `<br>Defender: ${last.defender} — ${last.defenderPlayType || '-'}`;

        document.getElementById('undoMessage').innerHTML = msg;
        document.getElementById('undoModal').style.display = 'flex';
    }

    function confirmUndo() {
        if (stateHistory.length > 0) {
            currentState = JSON.parse(JSON.stringify(stateHistory.pop()));
        } else if (currentState.plays.length > 0) {
            currentState.plays.pop();
        } else {
            document.getElementById('undoModal').style.display = 'none';
            return;
        }

        pendingPlay = null;
        savePlays();
        updateDisplay();
        calculateTeamStats();
        renderPlayLog();
        showAlert('Play undone — batter & defender restored');
        document.getElementById('undoModal').style.display = 'none';
    }

    function cancelUndo() {
        document.getElementById('undoModal').style.display = 'none';
    }

    // ==================== CONFIRM PLAY WITH BETTER SAVING ====================
    function confirmPlay() {
        if (!pendingPlay) return showAlert('No play selected');
        saveState();                    // ← Reliable snapshot before any change

        // ... (your entire original confirmPlay logic stays here unchanged) ...

        savePlays();
        pendingPlay = null;
        updateDisplay();
        renderPlayLog();   // ensure log updates
    }

    // ==================== PLAY LOG FUNCTIONS (already in your file) ====================
    let editIndex = -1;

    function renderPlayLog() {
        const tbody = document.getElementById('playLogTable').querySelector('tbody');
        tbody.innerHTML = '';

        currentState.plays.forEach((play, i) => {
            const half = (play.team === currentState.leadoff ? 'Top' : 'Bottom');
            const row = document.createElement('tr');
            row.innerHTML = `
                <td>${play.inning || '-'}</td>
                <td>${half}</td>
                <td>${escapeHtml(play.player || '-')}</td>
                <td>${escapeHtml(play.defender || '-')}</td>
                <td><strong>${escapeHtml(play.playType || play.defenderPlayType || '-')}</strong></td>
                <td>
                    <button onclick="startEditPlay(${i})" style="margin-right:6px;">Edit</button>
                    <button onclick="deletePlay(${i})" style="background:#dc3545;color:white;">Delete</button>
                </td>
            `;
            tbody.appendChild(row);
        });
    }

    // ... keep your startEditPlay, saveEditedPlay, deletePlay, recalculateAfterEdit, export/import functions ...

    // Hook updates
    const originalUpdateDisplay = updateDisplay;
    window.updateDisplay = function() {
        if (typeof originalUpdateDisplay === 'function') originalUpdateDisplay();
        renderPlayLog();
    };

    // Initial load
    window.onload = function() {
        loadGameState();
        setTimeout(() => {
            renderPlayLog();
            calculateTeamStats();
        }, 600);
    };
    </script>
</body>
</html>
